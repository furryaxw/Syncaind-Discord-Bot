# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# --- 必填 ---
# 机器人 token（Discord Developer Portal → Bot → Reset Token）
DISCORD_TOKEN=
# 目标服务器 ID（单服务器部署；必填，否则命令会同步到全局）
GUILD_ID=
# 你自己的 Discord 用户 ID（owner 白名单，用于 /module 等框架级命令）
OWNER_ID=

# --- 可选 ---
# 处罚日志频道 ID（moderation 模块把每条处罚动作发到这里）
MOD_LOG_CHANNEL_ID=
# 数据库文件与日志目录
DATABASE_PATH=data/bot.db
LOG_DIR=data/logs
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 翻译回退语言（非 zh-CN 的客户端都用它）。
# 反应角色与处罚通知是私信发出的，而私信里拿不到对方的客户端语言，
# 所以这些通知的语言由这里决定——中文服务器填 zh-CN。
DEFAULT_LOCALE=en-US

# --- GitHub ---
# 在 GitHub 上建一个 OAuth App（Settings → Developer settings → OAuth Apps）：
#   * 勾选 Enable device flow → 设备流可用（只需要 client_id，不需要 client_secret）
#   * 想要 web flow（网页点一下授权，更顺）→ 还要填下面两项，并把
#     GITHUB_OAUTH_REDIRECT_URI 原样填进该 OAuth App 的 Authorization callback URL
GITHUB_OAUTH_CLIENT_ID=
# 只有 web flow 需要；务必保密（它等价于应用的身份）
GITHUB_OAUTH_CLIENT_SECRET=
# 回调地址。**回调是「你的浏览器跳转过去」的，不是 GitHub 的服务器来访问**，
# 所以只要你的浏览器能打开它就行（不必公网）。
# 只有将来的 GitHub webhook 才真需要公网地址。
GITHUB_OAUTH_REDIRECT_URI=

# 读 release 用的令牌。建 classic PAT 时**一个 scope 都不要勾**：
# 公开仓库只读就够，泄露也无法修改你的仓库，同时额度从 60 次/小时提到 5000。
# 留空也能用（回填几个仓库够），但仓库多了会撞匿名限流。
GITHUB_TOKEN=

# --- gh-webhook-watcher ---
# 配了这两项，机器人就用 SSE 常驻订阅它的 /api/stream：有新 release 立刻推到对应帖子。
# 不配也能用：靠 /feed sync 手动推（绑定时回填历史照常走 GitHub API）。
WATCHER_BASE_URL=http://127.0.0.1:25056
# 它对 /api/* 的令牌（GHW_API_TOKEN）；没带令牌的请求会被拒。
WATCHER_API_TOKEN=

# --- SMAS ---
# 机器人以**自己的服务号**身份连它（不代替用户行事）。三项齐了才启用「节点 → 角色同步」与发激活码。
# 服务器侧要在 SMAS_SERVICE_ACCOUNTS 里放**同样的 id 与密钥**（id 必须非数字、密钥至少 32 字符）。
ACCESS_BASE_URL=http://127.0.0.1:8787
ACCESS_SERVICE_ID=discord-bot
# 服务号的密钥；务必保密（它等价于机器人这个身份）
ACCESS_SERVICE_SECRET=

# 服务号还需要在服务器侧被**授权**（管理员用现有节点/模板给它，没有旁路）：
#   system.users.read              读「某人的有效权限」——节点 → 角色同步要用
#   team.<team_id>.keys.distribute 发激活码。注意 require_grantable 会拦：
#                                  **机器人开出的 key 不能超过它自己持有的节点**

# 入站 HTTP 端点。0 = 不启动（默认）。
# 对外暴露交给反向代理或隧道，机器人自己只监听本地。
WEB_HOST=127.0.0.1
WEB_PORT=0
